{
  "name": "Deck",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Name of the deck"
    },
    "description": {
      "type": "string",
      "description": "Optional description"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether the deck can be viewed via share link"
    },
    "share_token": {
      "type": "string",
      "description": "Unique token for share link"
    },
    "clue_mode": {
      "type": "string",
      "enum": [
        "allowed",
        "disabled"
      ],
      "default": "allowed",
      "description": "Whether test takers can use the eliminate-one clue"
    },
    "clue_default_revealed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the short clue is shown by default before answering"
    },
    "cover_image_url": {
      "type": "string",
      "description": "URL of the deck cover image (custom upload or picked from a card)"
    },
    "cover_focal_point": {
      "type": "object",
      "description": "Focal point for cover image cropping, as {x, y} percentages (0-100)",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "cover_image_original_url": {
      "type": "string",
      "description": "Pre-crop original cover image URL. Set on first crop; absent means cover_image_url is the original."
    },
    "hero_image_url": {
      "type": "string",
      "description": "URL of the deck hero image, used as the background of the deck editing header and the study settings page. When absent, cover_image_url is used instead."
    },
    "hero_focal_point": {
      "type": "object",
      "description": "Focal point for hero image cropping, as {x, y} percentages (0-100)",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "hero_image_original_url": {
      "type": "string",
      "description": "Pre-crop original hero image URL. Set on first crop; absent means hero_image_url is the original."
    },
    "hero_scrim_disabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, the chromatic scrim over the deck editing header hero is suppressed entirely."
    },
    "hero_text_tone": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light",
      "description": "Text color treatment for the deck editing header. 'light' is white text over the chromatic scrim. 'dark' is near-black text with the scrim suppressed, for bright or flat-color cover art that the scrim muddies."
    },
    "accent_color": {
      "type": "string",
      "description": "Optional manual override for the header scrim color, as a hex string like #4A7C2F. When absent, the color is auto-extracted from the cover image."
    },
    "question_bg_color": {
      "type": "string",
      "description": "Optional hex color for the study question block background. When absent, defaults to the theme's light-blue study pane color."
    },
    "question_bg_image": {
      "type": "boolean",
      "default": false,
      "description": "When true, cards with an image render that image as the question block background, overlaid with the block color using screen blend mode."
    },
    "mastery_min_sessions": {
      "type": "number",
      "default": 3,
      "description": "Minimum number of deck completions before mastery is evaluated"
    },
    "mastery_pct": {
      "type": "number",
      "default": 90,
      "description": "Percentage of correct responses required to consider a card mastered (0-100)"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.is_public": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}