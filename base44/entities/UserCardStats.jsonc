{
  "name": "UserCardStats",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user this stat belongs to"
    },
    "deck_id": {
      "type": "string",
      "description": "ID of the deck the card belongs to"
    },
    "card_id": {
      "type": "string",
      "description": "ID of the card this stat is for"
    },
    "correct_attempts": {
      "type": "number",
      "default": 0,
      "description": "Total number of times the user has correctly answered this card across all sessions"
    },
    "total_attempts": {
      "type": "number",
      "default": 0,
      "description": "Total number of times the user has been shown this card across all sessions"
    },
    "sessions_completed": {
      "type": "number",
      "default": 0,
      "description": "Number of deck sessions in which this card appeared"
    },
    "mastered": {
      "type": "boolean",
      "default": false,
      "description": "Whether the card is considered mastered by the user in this deck"
    },
    "last_studied_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last study attempt for this card by the user"
    },
    "first_studied_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the first ever attempt on this card. Set once, never updated."
    },
    "total_time_ms": {
      "type": "number",
      "default": 0,
      "description": "Cumulative answer time across all attempts (untimed attempts contribute 0)"
    },
    "fastest_answer_ms": {
      "type": "number",
      "description": "Fastest recorded time_to_answer_ms for this card"
    },
    "mastered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When mastery FIRST flipped true. Set once; preserved even if mastered later flips false."
    },
    "attempts_to_master": {
      "type": "number",
      "description": "total_attempts at the moment mastery first flipped true"
    },
    "sessions_to_master": {
      "type": "number",
      "description": "sessions_completed at the moment mastery first flipped true"
    },
    "study_time_to_master_ms": {
      "type": "number",
      "description": "total_time_ms at the moment mastery first flipped true"
    },
    "mastery_score": {
      "type": "number",
      "description": "Current mastery score 0\u2013100 (rounded) from statsUtils.masteryScore(). Null/absent = no scored sessions yet."
    },
    "mastery_level": {
      "type": "string",
      "enum": [
        "new",
        "learning",
        "familiar",
        "proficient",
        "mastered"
      ],
      "default": "new",
      "description": "Current mastery level from statsUtils.masteryLevel()."
    },
    "mastery_weighted_sum": {
      "type": "number",
      "default": 0,
      "description": "Mastery running state: decayed sum of per-session credit (newest weight 1). See statsUtils.stepMasteryState()."
    },
    "mastery_weight_total": {
      "type": "number",
      "default": 0,
      "description": "Mastery running state: decayed sum of weights. mastery_score = round(100 * weighted_sum / weight_total)."
    },
    "mastery_scored_sessions": {
      "type": "number",
      "default": 0,
      "description": "Mastery running state: number of scored sessions (review-missed runs and skipped cards excluded). Distinct from sessions_completed."
    },
    "mastery_last_key": {
      "type": "string",
      "description": "Mastery running state: result key from the most recent scored session. Mastered requires 'correct'."
    }
  },
  "required": [
    "user_id",
    "deck_id",
    "card_id"
  ]
}